PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fixmate_db

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
ENABLE_CRON=true

# Chatbot (Groq). Get a free key at https://console.groq.com/keys - never commit the real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Only for testing with a fake server; leave unset to use the real Groq API.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
